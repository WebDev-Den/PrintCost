{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kilo-g",
  "account_id": "5bde96caf887560714ca70d575ed9ea9",
  "compatibility_date": "2026-10-08",
  "main": "workers/index.ts",
  "minify": true,
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "kilo-g",
    "TURNSTILE_HOSTNAMES": "web-dev.pp.ua,kilo-g.web-developer-den.workers.dev"
  },
  "secrets": { "required": ["TURNSTILE_SECRET_KEY", "FIREBASE_IMPORT_SERVICE_ACCOUNT"] },
  "d1_databases": [{
    "binding": "ANALYTICS_DB",
    "database_name": "kilog-analytics",
    "database_id": "d837dab8-8871-43d1-8cfc-df6c4d03b8d2",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "ANALYTICS_RATE_LIMIT",
    "namespace_id": "129761",
    "simple": { "limit": 60, "period": 60 }
  }, { "name": "IMPORT_RATE_LIMIT", "namespace_id": "129762", "simple": { "limit": 30, "period": 60 } }],
  "queues": {
    "producers": [{ "binding": "IMPORT_QUEUE", "queue": "kilog-imports" }],
    "consumers": [{ "queue": "kilog-imports", "max_batch_size": 1, "max_batch_timeout": 1,
      "max_concurrency": 1, "max_retries": 3, "retry_delay": 60 }]
  },
  "triggers": { "crons": ["0 2 * * *", "*/5 * * * *"] }
}
