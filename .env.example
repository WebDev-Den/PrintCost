# Public Firebase web-app configuration (Firebase Console > Project settings).
# All four values are required by the production Vite build.
# .env.production contains the public kilo-g config used by Git builds.
# For Worker kilo-g: Settings > Build > Build Variables and Secrets.
# Runtime Worker bindings do not configure the static browser bundle.
# Set NODE_VERSION=22.23.2 in the Cloudflare build settings (.nvmrc also pins it).
# Never put a service account, private key, or admin credential in VITE_* variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=kilo-g
VITE_FIREBASE_APP_ID=

# Local testing only. Never enable for a production build.
VITE_USE_FIREBASE_EMULATORS=false
